+    def remove(self, name, qty):
+        current = self._stock.get(name, 0)
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} from {name}: only {current} in stock")
+        current -= qty
+        if current == 0:
+            del self._stock[name]
+        else:
+            self._stock[name] = current
+
     def count(self, name):
         return self._stock.get(name, 0)
 
