@@ -1,6 +1,28 @@
+import time
+import threading
+
 sent = []
 
+# Rate limit: max 10 messages per second per user.
+_lock = threading.Lock()
+_window_start: dict[str, float] = {}
+_window_count: dict[str, int] = {}
+RATE_LIMIT = 10
+WINDOW_SECONDS = 1.0
+
 def send_message(user_id, text):
     """Pretend to send a message."""
+    now = time.monotonic()
+    with _lock:
+        start = _window_start.get(user_id, 0)
+        count = _window_count.get(user_id, 0)
+        if now - start >= WINDOW_SECONDS:
+            # New window.
+            _window_start[user_id] = now
+            _window_count[user_id] = 1
+        elif count >= RATE_LIMIT:
+            return False
+        else:
+            _window_count[user_id] = count + 1
     sent.append((user_id, text))
     return True
