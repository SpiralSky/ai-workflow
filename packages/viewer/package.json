{
  "name": "@aiw/viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "build:indexer": "node indexer/build.mjs",
    "index": "node indexer/dist/index.js",
    "index:watch": "node indexer/dist/index.js --watch",
    "build": "npm run build:indexer && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "shiki": "^1.24.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
