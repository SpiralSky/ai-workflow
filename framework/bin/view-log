<script>
const RUNS = ${JSON.stringify(slim)};
let selected = -1;

function esc(s) {
  return String(s ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}
function fmtN(n) {
  if (!n) return "0";
  return n >= 1000 ? (n/1000).toFixed(1)+"k" : String(n);
}
function tokPills(u) {
  if (!u) return "";
  const parts = [];
  if (u.cacheRead > 0) parts.push(\`<span class="tok cr" title="cache read">↩\${fmtN(u.cacheRead)}</span>\`);
  if (u.cacheWrite > 0) parts.push(\`<span class="tok cw" title="cache write">⊕\${fmtN(u.cacheWrite)}</span>\`);
  const uncached = Math.max(0, u.input - (u.cacheRead ?? 0) - (u.cacheWrite ?? 0));
  if (uncached > 0) parts.push(\`<span class="tok inp" title="uncached input">→\${fmtN(uncached)}</span>\`);
  if (u.output > 0) parts.push(\`<span class="tok out" title="output">↑\${fmtN(u.output)}</span>\`);
  return \`<span class="tokens">\${parts.join("")}</span>\`;
}
function toolPreview(name, input) {
  if (!input) return "";
  const key = ["command","pattern","code","intent","query","file_path","path"].find(k => input[k] !== undefined) ?? Object.keys(input)[0];
  if (!key) return "";
  const val = String(input[key] ?? "").replace(/\\n/g," ").slice(0, 70);
  return \`<span class="tool-preview">\${esc(val)}\${val.length >= 70 ? "…" : ""}</span>\`;
}
function renderContent(c) {
  if (c.type === "text") return \`<div class="text-block">\${esc(c.text)}</div>\`;
  if (c.type === "thinking") return \`<details class="tool-use"><summary><span class="tool-name">💭 Thinking</span></summary><pre>\${esc(c.thinking)}</pre></details>\`;
  if (c.type === "tool_use") {
    const inputJson = c.inputStr ?? JSON.stringify(c.input ?? {}, null, 2);
    return \`<details class="tool-use"><summary><span class="tool-name">\${esc(c.name)}</span>\${toolPreview(c.name, c.input)}</summary><pre>\${esc(inputJson)}</pre></details>\`;
  }
  return "";
}
function renderToolResult(r) {
  const badge = r.isError ? \`<span class="err-badge">error</span>\` : \`<span class="ok-badge">ok</span>\`;
  return \`<details class="tool-result"><summary><span class="tool-name">\${esc(r.toolName)}</span>\${badge}</summary><pre>\${esc(r.contentStr ?? r.content ?? "")}</pre></details>\`;
}
function renderBranchCall(bc) {
  if (!bc) return "";
  const helpers = bc.helpers.map(h => {
    const resultCol = h.error
      ? \`<span class="helper-err">⚠ \${esc(String(h.error).slice(0,120))}</span>\`
      : \`<span class="helper-result">\${esc(h.resultStr ?? "")}</span>\`;
    return \`<div class="helper-call"><span class="helper-name">\${esc(h.name)}</span><span class="helper-args">\${esc(h.argsStr)}</span>\${resultCol}<span class="helper-ms">\${h.durationMs}ms</span></div>\`;
  }).join("");
  return \`<details class="branch-trace">
    <summary>\${esc(bc.intent || "(no intent)")}<span class="branch-kind \${esc(bc.kind)}">\${esc(bc.kind)}</span><span class="branch-time">\${bc.durationMs}ms</span></summary>
    <div class="branch-path">\${esc(bc.path)}</div>
    \${helpers ? \`<div class="helper-calls">\${helpers}</div>\` : ""}
    <details class="branch-code"><summary>Code</summary><pre>\${esc(bc.code)}</pre></details>
  </details>\`;
}
function renderTurn(t, i) {
  const meta = \`<div class="msg-meta">
    <span class="badge model-badge">\${esc(t.model)}</span>
    \${tokPills(t.usage)}
    <span style="color:var(--text3);font-size:11px">Turn \${i+1}</span>
  </div>\`;
  const content = t.content.map(renderContent).join("");
  const results = (t.toolResults ?? []).map(renderToolResult).join("");
  const branch = (t.branchCalls ?? []).map(renderBranchCall).join("");
  return \`<div class="turn">\${meta}\${content}\${results}\${branch}</div>\`;
}
function renderRun(b) {
  const p = b.parsed ?? {};
  const r = p.result ?? {};
  const passBadge = b.pass === true ? \`<span class="badge pass">pass</span>\`
    : b.pass === false ? \`<span class="badge fail">fail</span>\`
    : \`<span class="badge unknown">?</span>\`;
  const totalU = r.totalUsage ?? {};
  const header = \`<div id="run-header">
    <h1>\${esc(b.tag)} \${passBadge} <span class="model-badge">\${esc(p.model || r.model || "")}</span></h1>
    <div class="total-stats">
      turns: \${r.numTurns} · cost: $\${(r.cost ?? 0).toFixed(4)} · \${(r.durationMs/1000).toFixed(1)}s
      · \${tokPills(totalU)}
    </div>
  </div>\`;
  const prompt = b.systemPrompt
    ? \`<details class="section"><summary>System Prompt</summary><pre>\${esc(b.systemPrompt)}</pre></details>\`
    : "";
  const humanMsgs = (p.humanMessages ?? []).map(m => {
    const ts = m.timestamp ? \` · <span style="color:var(--text3)">\${esc(m.timestamp.slice(0,19).replace("T"," "))}</span>\` : "";
    return \`<div class="human-turn"><div class="human-meta">🧑 User\${ts}</div><div class="human-text">\${esc(m.text)}</div></div>\`;
  }).join("");
  const turns = (p.turns ?? []).map((t, i) => renderTurn(t, i)).join("");
  const finalSection = b.finalMsg
    ? \`<details class="final-msg" open><summary>✓ Final answer</summary><pre>\${esc(b.finalMsg.trim())}</pre></details>\`
    : "";
  const testsSection = b.testsResult
    ? \`<details class="section"><summary>Test output</summary><pre>\${esc(b.testsResult.trim())}</pre></details>\`
    : "";
  return header + prompt + humanMsgs + turns + finalSection + testsSection;
}
function buildSidebar() {
  const list = document.getElementById("run-list");
  list.innerHTML = RUNS.map((b, i) => {
    const p = b.parsed?.result ?? {};
    const passCls = b.pass === true ? "pass" : b.pass === false ? "fail" : "unknown";
    return \`<div class="run-item" onclick="selectRun(\${i})">
      <div class="run-tag">\${esc(b.tag)}</div>
      <div class="run-meta"><span class="badge \${passCls}">\${b.pass === true ? "pass" : b.pass === false ? "fail" : "?"}</span>
      turns:\${p.numTurns ?? "?"} $\${(p.cost ?? 0).toFixed(3)}</div>
    </div>\`;
  }).join("");
}
function selectRun(i) {
  selected = i;
  document.querySelectorAll(".run-item").forEach((el, j) => el.classList.toggle("active", j === i));
  document.getElementById("empty-state").style.display = "none";
  const view = document.getElementById("run-view");
  view.style.display = "";
  view.innerHTML = renderRun(RUNS[i]);
}
buildSidebar();
if (RUNS.length > 0) selectRun(0);
</script>
</body>
</html>`;
}

// ─── Server ──────────────────────────────────────────────────────────────────

const arg = process.argv[2];
const defaultRunsDir = path.join(ROOT, "experiments", "runs");
const targetPath = arg ? path.resolve(arg) : (fs.existsSync(defaultRunsDir) ? defaultRunsDir : ROOT);

let bundles;
try {
  bundles = discoverBundles(targetPath);
} catch (e) {
  console.error("Error loading runs:", e.message);
  bundles = [];
}

if (bundles.length === 0) {
  console.log(`No runs found in: ${targetPath}`);
  process.exit(0);
}

console.log(`Loaded ${bundles.length} run(s) from: ${targetPath}`);

const server = http.createServer((req, res) => {
  res.setHeader("Content-Type", "text/html; charset=utf-8");
  res.end(buildHTML(bundles));
});

server.listen(0, "127.0.0.1", () => {
  const { port } = server.address();
  const url = `http://127.0.0.1:${port}`;
  console.log(`Viewer: ${url}`);
  for (const cmd of ["xdg-open", "open"]) {
    try { execSync(`${cmd} ${url} 2>/dev/null`); break; } catch { /* try next */ }
  }
});
